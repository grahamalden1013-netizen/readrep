# NextRep runs the seeded demo with none of these set.
# Copy to .env.local and fill in only what you need.

# --- Accounts (optional) -----------------------------------------------------
# Enables sign up / log in. Without them the app still works; the demo session,
# the upload flow and the dashboard all run on a local, cookie-backed store.
# Apply supabase/migrations/0001_nextrep.sql to the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Video hosting (not yet wired) -------------------------------------------
# V1 has no upload target: /games/new records the game and player identity but
# leaves the file on the device. These are the variables the Mux integration
# will read once it lands. Server-only — never prefix them with NEXT_PUBLIC_.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
