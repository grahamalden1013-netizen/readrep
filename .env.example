NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Coach Interview -----------------------------------------------------
# Server-only. Create a key at https://console.anthropic.com/settings/keys and
# put it in .env.local. Without it, /coach/playbook/interview says so plainly
# rather than faking intelligence.
#
# NEVER prefix this with NEXT_PUBLIC_ — that would ship the key to browsers.
# NEVER commit a real value.
ANTHROPIC_API_KEY=

# Which model runs the Coach Interview. Optional; defaults to claude-opus-5.
# Configurable so quality, latency and cost can be tuned without touching the
# interview engine.
ANTHROPIC_INTERVIEW_MODEL=claude-opus-5

# Automated tests only. `mock` swaps the provider for scripted, clearly-labelled
# responses that the UI marks as fake. Leave unset everywhere else.
# READREP_AI_MODE=mock
