# NextRep runs the seeded five-rep demo with none of these set.
# Copy to .env.local (git-ignored) and fill in what you need.

# --- Accounts and durable storage -------------------------------------------
# Required to store real uploaded film. Without them, authored games and reps
# fall back to a local development file store (.nextrep-data), which is
# disabled outside development.
# Apply supabase/migrations/0001_nextrep.sql first, then add "nextrep" to
# Settings -> API -> Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required ONLY if Supabase is configured and you want webhooks to
# work: a webhook carries no user session, so row-level security would hide
# every game from it. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Video hosting (Mux) -----------------------------------------------------
# Required for real uploads. Without them, development uses a clearly labelled
# fixture pipeline; production refuses uploads rather than faking them.
# Mux dashboard -> Settings -> Access Tokens (needs Mux Video read + write).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux dashboard -> Settings -> Webhooks. Signing secret for POST /api/mux/webhook.
# Without it the webhook route returns 503 and status falls back to polling.
MUX_WEBHOOK_SECRET=

# --- Development overrides ---------------------------------------------------
# Force the fixture video pipeline even when Mux credentials are present.
# NEXTREP_VIDEO_PROVIDER=fixture
#
# Where the development file store writes. Defaults to ./.nextrep-data
# NEXTREP_DATA_DIR=
