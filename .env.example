# ---------------------------------------------------------------------------
# ReadRep — environment variable reference
#
# NAMES AND DESCRIPTIONS ONLY. Never put a real value in this file.
# Copy to `.env.local` inside apps/web and fill values there. `.env*` is
# gitignored except this file.
# ---------------------------------------------------------------------------

# --- Phase 0 (required to run locally) -------------------------------------

# Secret used to sign the Phase 0 local development session cookie (HMAC-SHA256).
# Generate with: openssl rand -hex 32
# Phase 0 auth is local-only and is NOT a production identity provider.
READREP_SESSION_SECRET=

# Directory for the Phase 0 local data adapter (JSON documents on disk).
# Defaults to `.data` inside apps/web. Gitignored. Never point this at a
# directory containing real game footage or production data.
READREP_DATA_DIR=

# Log verbosity for @readrep/observability: debug | info | warn | error
READREP_LOG_LEVEL=

# ---------------------------------------------------------------------------
# --- Phase 1+ (NOT USED YET — reserved so the boundary is documented) ------
#
# None of these are read by any code in this repository today. They are listed
# so the credentials required for later phases are explicit. See
# docs/ROADMAP.md and docs/REQUIRED_CREDENTIALS.md.
# ---------------------------------------------------------------------------

# Phase 1 — managed PostgreSQL
# DATABASE_URL=

# Phase 1 — video provider (Mux or equivalent): direct upload, playback, webhooks
# VIDEO_PROVIDER_TOKEN_ID=
# VIDEO_PROVIDER_TOKEN_SECRET=
# VIDEO_PROVIDER_WEBHOOK_SECRET=
# VIDEO_PROVIDER_SIGNING_KEY_ID=
# VIDEO_PROVIDER_SIGNING_KEY_PRIVATE=

# Phase 1 — private object storage for derived frames, crops, and artifacts
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Phase 2 — GPU compute (Modal or equivalent)
# GPU_PROVIDER_TOKEN_ID=
# GPU_PROVIDER_TOKEN_SECRET=

# Phase 3/4 — model providers. No paid model call exists in this repository yet.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Phase 5 — billing
# BILLING_PROVIDER_SECRET_KEY=
# BILLING_PROVIDER_WEBHOOK_SECRET=
