# Supabase — optional. Without these the app runs on seeded demo content and a
# local demo session cookie instead of real accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — optional. Without a key, "I don't get it", Ask NGN and
# GENERATE DRAFT are served by the mock provider in lib/ai/mock.ts, which
# answers only from approved article material.
ANTHROPIC_API_KEY=

# News ingestion — optional. Without a key the daily briefing job in
# lib/news/pipeline.ts reports that there is nothing to review rather than
# inventing stories.
NEWS_API_KEY=
