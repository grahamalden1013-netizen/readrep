# Supabase — optional. Without these, NGN runs in demo mode: Arena state is
# kept on the device and all seeded content is served from data/demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — optional. Without a key, every AI service falls back to a
# deterministic local implementation: the judge, the perspective judge, the
# explainer, moderation and the admin draft generator all still work.
ANTHROPIC_API_KEY=
