# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Test / tooling output
# ---------------------------------------------------------------------------
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
.playwright/

# ---------------------------------------------------------------------------
# Secrets and environment
# Only .env.example (names + descriptions, never values) is committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
service-account*.json
gha-creds-*.json

# ---------------------------------------------------------------------------
# PRIVATE MEDIA AND DERIVED ARTIFACTS — NEVER COMMIT
#
# ReadRep processes game video of minors. Original footage, derived frames,
# player crops, embeddings, overlays, and analysis artifacts are private data
# and must never enter version control. See docs/PRIVACY_AND_SECURITY.md.
# ---------------------------------------------------------------------------
.data/
media/
footage/
game-film/
uploads/
frames/
crops/
embeddings/
overlays/
artifacts/
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.mpg
*.mpeg
*.ts.video
*.m3u8
*.mpd
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.npy
*.pt
*.onnx
*.safetensors

# Committed UI assets are explicitly re-allowed here. Anything added to this
# allowlist must be a product asset, never footage or a player crop.
!apps/web/public/**/*.svg
!apps/web/src/app/favicon.ico

# ---------------------------------------------------------------------------
# Database artifacts
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
pgdata/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
.vercel
