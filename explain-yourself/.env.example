# ─────────────────────────────────────────────────────────────────────────────
# Explain Yourself — example environment. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase project (safe to ship in the iOS binary) -----------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_PUBLIC_KEY

# --- Server-only. NEVER put these in the iOS app or any client bundle. -------
# Used only by `supabase` CLI / Edge Functions / the cleanup cron.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SIDE_ONLY
SUPABASE_DB_PASSWORD=REPLACE_SERVER_SIDE_ONLY

# --- Optional AI provider (the game is fully playable without it) ------------
# Consumed ONLY by the `generate-flavor` Edge Function, never by the app.
AI_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gameplay asset lifetime -------------------------------------------------
GAMEPLAY_ASSET_TTL_MINUTES=180
SIGNED_URL_TTL_SECONDS=300
