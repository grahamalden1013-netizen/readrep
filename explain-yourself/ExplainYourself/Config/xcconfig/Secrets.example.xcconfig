// Copy to `Secrets.xcconfig` (git-ignored) and fill in.
//
// Both of these values are safe to compile into the app. The anon key is a
// public project identifier; every row level security policy in this project
// assumes an attacker already has it.
//
// The service role key is NOT safe and must never appear in this file or any
// other file the app target can see.

EY_SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
EY_SUPABASE_ANON_KEY = REPLACE_WITH_ANON_PUBLIC_KEY
EY_PRIVACY_POLICY_URL = https:/$()/example.com/privacy
