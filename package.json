{
  "name": "readrep",
  "version": "0.1.0",
  "private": true,
  "description": "ReadRep \u2014 AI-powered basketball decision-training system built from a player's real game film.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "pnpm --filter @readrep/web dev",
    "build": "pnpm --filter @readrep/web build",
    "start": "pnpm --filter @readrep/web start",
    "seed": "pnpm --filter @readrep/web seed",
    "lint": "eslint .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
