    "doctor": "tsx scripts/doctor.mts",
    "setup": "./scripts/setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
